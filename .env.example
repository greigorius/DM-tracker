NOTION_TOKEN=

# Hub v2 snapshot layer uses data source IDs; defaults are in hub-core/config.js.
# Override only if a DB moves: NOTION_DS_TASKS, NOTION_DS_RFIS, NOTION_DS_VARIATIONS,
# NOTION_DS_SUBMISSIONS, NOTION_DS_DRAWINGS, NOTION_DS_ACTIONS, NOTION_DS_TODO,
# NOTION_DS_PROJECTS, NOTION_DS_CLIENTS, NOTION_DS_TEAM, NOTION_DS_ACTIVITY,
# NOTION_DS_MEETINGS, NOTION_DS_FINISHES

# Optional: shared secret for the sync-full-background trigger
HUB_SYNC_KEY=

# Launch tiles for tools not yet in the Hub. Defaults live in src/config/tools.js;
# set any of these only to override them.
# VITE_URL_SCHEDULING, VITE_URL_DRAWING_FLOW,
# VITE_URL_DRAWING_STUDIO, VITE_URL_REPORT_CLIENT, VITE_URL_REPORT_HOURS
VITE_URL_ACTIVITY_LOG=

PORT=3001

# Team page DT emails: Make webhook URL (Send is disabled when unset)
TEAM_EMAIL_WEBHOOK_URL=
# Set to off once the To Do "Task Done" property is deleted
# TODO_MIRROR_TASK_DONE=off

# Derived item Ball In Court: off | dry (default, review in Triage) | on (each sync writes up to 40)
# ITEM_BIC_AUTO=dry
